generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ShowType {
  SERIES
  MOVIE
  OVA
  SPECIAL
  DOCUMENTARY
}

enum ShowStatus {
  ONGOING
  COMPLETED
  UPCOMING
}

enum SourceLanguage {
  SUB
  DUB
  RAW
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  role           UserRole       @default(USER)
  emailVerified  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  profile        Profile?
  bookmarks      Bookmark[]
  history        WatchHistory[]
  ratings        Rating[]
  accounts       Account[]
  sessions       Session[]
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  displayName    String
  avatarUrl      String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Show {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  altTitles        String[]
  synopsis         String
  releaseYear      Int
  status           ShowStatus
  type             ShowType
  totalEpisodes    Int
  language         String
  posterUrl        String
  bannerUrl        String?
  featuredScore    Int                 @default(0)
  viewCount        Int                 @default(0)
  isTrending       Boolean             @default(false)
  isLatestRelease  Boolean             @default(false)
  isRecentlyAdded  Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  episodes         Episode[]
  ratings          Rating[]
  bookmarks        Bookmark[]
  watchHistory     WatchHistory[]
  genres           ShowGenre[]
  tags             ShowTag[]
  studios          ShowStudio[]
  producers        ShowProducer[]
  recommendationsFrom ShowRecommendation[] @relation("show_recommendations_from")
  recommendationsTo   ShowRecommendation[] @relation("show_recommendations_to")
  homepageFeatures HomepageFeature[]
}

model Episode {
  id               String                @id @default(cuid())
  showId           String
  slug             String
  episodeNumber    Int
  title            String
  description      String?
  thumbnailUrl     String?
  releaseDate      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  show             Show                  @relation(fields: [showId], references: [id], onDelete: Cascade)
  sources          ExternalVideoSource[]
  watchHistory     WatchHistory[]

  @@unique([showId, episodeNumber])
  @@unique([showId, slug])
}

model Genre {
  id           String     @id @default(cuid())
  name         String     @unique
  slug         String     @unique
  shows        ShowGenre[]
}

model Tag {
  id           String     @id @default(cuid())
  name         String     @unique
  slug         String     @unique
  shows        ShowTag[]
}

model Studio {
  id           String       @id @default(cuid())
  name         String       @unique
  slug         String       @unique
  shows        ShowStudio[]
}

model Producer {
  id           String         @id @default(cuid())
  name         String         @unique
  slug         String         @unique
  shows        ShowProducer[]
}

model ExternalVideoSource {
  id               String          @id @default(cuid())
  episodeId        String
  label            String
  embedUrl         String
  externalWatchUrl String?
  language         SourceLanguage  @default(SUB)
  qualityLabel     String?
  sortOrder        Int             @default(0)
  isPrimary        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  episode          Episode         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  showId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  show        Show     @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([userId, showId])
}

model WatchHistory {
  id                String   @id @default(cuid())
  userId            String
  showId            String
  episodeId         String
  progressSeconds   Int      @default(0)
  completed         Boolean  @default(false)
  lastWatchedAt     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  show              Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  episode           Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

model Rating {
  id          String   @id @default(cuid())
  userId      String
  showId      String
  score       Int
  reviewText  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  show        Show     @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([userId, showId])
}

model ShowRecommendation {
  id                  String   @id @default(cuid())
  showId              String
  recommendedShowId   String
  weight              Int      @default(1)
  createdAt           DateTime @default(now())
  show                Show     @relation("show_recommendations_from", fields: [showId], references: [id], onDelete: Cascade)
  recommendedShow     Show     @relation("show_recommendations_to", fields: [recommendedShowId], references: [id], onDelete: Cascade)

  @@unique([showId, recommendedShowId])
}

model HomepageFeature {
  id          String   @id @default(cuid())
  showId      String
  section     String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  show        Show     @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([section, showId])
}

model ShowGenre {
  showId      String
  genreId     String
  show        Show   @relation(fields: [showId], references: [id], onDelete: Cascade)
  genre       Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([showId, genreId])
}

model ShowTag {
  showId      String
  tagId       String
  show        Show   @relation(fields: [showId], references: [id], onDelete: Cascade)
  tag         Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([showId, tagId])
}

model ShowStudio {
  showId      String
  studioId    String
  show        Show    @relation(fields: [showId], references: [id], onDelete: Cascade)
  studio      Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([showId, studioId])
}

model ShowProducer {
  showId      String
  producerId  String
  show        Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  producer    Producer  @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@id([showId, producerId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
